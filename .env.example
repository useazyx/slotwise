# .env.example - Modelo das variáveis de ambiente do Slotwise
# # Pra que serve?
# - Mostrar tudo que a API precisa pra subir, sem nenhum segredo de verdade
# - O `npm run dev` copia esse arquivo pra .env sozinho se ele ainda não existir
# Feito por: Arthur Roberto Weege Pontes
# Versão: 1.2.0
# Data: 2026-09-11
# Alterações:
# - v1.0.0 (2026-09-11): Primeira versão
# - v1.1.0 (2026-09-11): QUEUE_WORKERS_ENABLED
# - v1.2.0 (2026-09-11): CORS_ORIGINS

PORT=3335
HOST=0.0.0.0
NODE_ENV=development

# Fuso usado pra montar os horários livres (a agenda é de um negócio no Brasil)
APP_TIMEZONE="America/Sao_Paulo"

# Instalação padrão do PostgreSQL. Se o seu usuário ou senha forem outros, troque aqui.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slotwise?schema=public"

# O setup gera um valor aleatório quando cria o .env
JWT_SECRET="troque-isso"
JWT_EXPIRES_IN="7d"

# Os workers da fila (lembretes e agenda do dia) rodam junto com a API
QUEUE_WORKERS_ENABLED=true

# Sites que podem chamar a API pelo navegador ("*" libera todos; em produção, liste separado por vírgula)
CORS_ORIGINS="*"
