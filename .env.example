# .env.example - Modelo das variáveis de ambiente do Pontual
# # Pra que serve?
# - Mostrar tudo que a API precisa pra subir, sem nenhum segredo de verdade
# - O `npm run dev` copia esse arquivo pra .env sozinho se ele ainda não existir
# Feito por: Arthur Roberto Weege Pontes
# Versão: 1.0.0
# Data: 2026-09-11
# Alterações:
# - v1.0.0 (2026-09-11): Primeira versão

PORT=3335
HOST=0.0.0.0
NODE_ENV=development

# Fuso usado pra montar os horários livres (a agenda é de um negócio no Brasil)
APP_TIMEZONE="America/Sao_Paulo"

# Instalação padrão do PostgreSQL. Se o seu usuário ou senha forem outros, troque aqui.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pontual?schema=public"

# O setup gera um valor aleatório quando cria o .env
JWT_SECRET="troque-isso"
JWT_EXPIRES_IN="7d"
